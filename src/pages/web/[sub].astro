---
// /web/product-detail, /web/promotion, /web/ui, /web/social
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { webSubs, webSubById, projectsByWebSub } from "../../data/portfolio";

export function getStaticPaths() {
  return webSubs.map((s) => ({ params: { sub: s.id } }));
}

const { sub } = Astro.params;
const cur = webSubById(sub!);
if (!cur) return Astro.redirect("/404");
const items = projectsByWebSub(cur.id);
const base = import.meta.env.BASE_URL;
---

<Base title={cur.label.ko} active="web" theme="dark">
  <section class="wrap page-head page-head--center">
    <h1>
      <span data-ko>{cur.label.ko}</span>
      <span data-en>{cur.label.en}</span>
    </h1>
    <nav class="subnav" aria-label="웹디자인 하위 분류">
      {
        webSubs.map((s) => (
          <a
            href={`${base}web/${s.id}`}
            aria-current={s.id === cur.id ? "page" : undefined}
          >
            <span data-ko>{s.label.ko}</span>
            <span data-en>{s.label.en}</span>
          </a>
        ))
      }
    </nav>
  </section>

  {
    items.length > 0 ? (
      <section class="wrap grid">
        {items.map((p) => (
          <Card project={p} />
        ))}
      </section>
    ) : (
      <section class="wrap" style="padding-bottom: 120px; color: var(--muted);">
        <span data-ko>아직 등록된 작업이 없습니다.</span>
        <span data-en>No projects yet.</span>
      </section>
    )
  }
</Base>

<style>
  /* 웹디자인은 제목·컨텐츠 모두 중앙 정렬 (메인 /web 과 동일) */
  .page-head--center {
    text-align: center;
  }
  .grid :global(.card__meta) {
    text-align: center;
  }

  .subnav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px 18px;
    margin-top: 14px;
  }
  .subnav a {
    font-size: 14px;
    color: var(--muted);
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
  }
  .subnav a:hover {
    color: var(--fg);
  }
  .subnav a[aria-current="page"] {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }
</style>
