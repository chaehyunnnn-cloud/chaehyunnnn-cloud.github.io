---
// /web — 웹디자인 메인.
// 하위 분류(제품 상세페이지 / 프로모션 / UI / 소셜)마다 한 섹션씩 세로로 쌓는다.
// 섹션 = [분류 제목(→ 하위 페이지)] + [작업 3개] + [View more(→ 하위 페이지)]
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { webSubs, projectsByWebSub, categoryById } from "../../data/portfolio";

const cat = categoryById("web")!;
const base = import.meta.env.BASE_URL;
const PREVIEW = 3; // 메인에서 한 분류당 보여줄 개수 (가로 3개)

const sections = webSubs.map((s) => {
  const items = projectsByWebSub(s.id);
  return { sub: s, items, shown: items.slice(0, PREVIEW), href: `${base}web/${s.id}` };
});
---

<Base title={cat.label.ko} active="web">
  <section class="wrap page-head page-head--center">
    <h1>
      <span data-ko>{cat.label.ko}</span>
      <span data-en>{cat.label.en}</span>
    </h1>
  </section>

  {
    sections.map(({ sub, items, shown, href }) => (
      <section class="wrap block">
        <header class="block__head">
          {/* 제목을 누르면 해당 하위 분류 페이지로 */}
          <a class="block__title" href={href}>
            <span data-ko>{sub.label.ko}</span>
            <span data-en>{sub.label.en}</span>
            <span class="block__arrow" aria-hidden="true">→</span>
          </a>
          {items.length > 0 && (
            <span class="block__count">{String(items.length).padStart(2, "0")}</span>
          )}
        </header>

        {shown.length > 0 ? (
          <div class="grid block__grid">
            {shown.map((p) => (
              <Card project={p} />
            ))}
          </div>
        ) : (
          <p class="block__empty">
            <span data-ko>아직 등록된 작업이 없습니다.</span>
            <span data-en>No projects yet.</span>
          </p>
        )}

        <div class="block__more">
          <a class="more-btn" href={href}>
            <span data-ko>더 보기</span>
            <span data-en>View more</span>
            <span class="more-btn__arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </section>
    ))
  }
</Base>

<style>
  /* ── 한 화면에 한 분류씩 (스크롤 스냅) ───────────────────────────────
     · html에 scroll-snap-type을 걸어야 해서 is:global 사용.
       이 스타일시트는 /web 페이지에서만 로드되므로 다른 페이지엔 영향 없음. */

  /* 웹디자인 메인은 제목·컨텐츠 모두 중앙 정렬 */
  .page-head--center {
    text-align: center;
  }

  /* 제목 화면 — 첫 스냅 지점 */
  .page-head--center {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    scroll-snap-align: start;
    padding-block: 0;
  }
  .page-head--center h1 {
    font-size: clamp(44px, 9vw, 116px);
  }

  /* 분류 한 개 = 한 화면 */
  .block {
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(72px, 10vh, 120px) clamp(24px, 5vh, 56px);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  /* 분류 제목 줄 — 제목 + 개수 */
  .block__head {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    padding-bottom: clamp(14px, 2vh, 24px);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(18px, 3vh, 32px);
  }
  .block__title {
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--fg);
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .block__arrow {
    font-size: 0.62em;
    color: var(--muted);
    transform: translateX(-4px);
    opacity: 0;
    transition: transform 0.28s var(--ease), opacity 0.28s var(--ease);
  }
  .block__title:hover .block__arrow {
    transform: none;
    opacity: 1;
  }
  .block__count {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 13px;
    color: var(--muted);
  }

  /* 컨텐츠 크게 — 카드 이미지 높이를 화면 비율로 */
  .block__grid {
    padding-bottom: 0;
  }
  .block__grid :global(.card__media) {
    aspect-ratio: auto;
    height: clamp(240px, 52vh, 620px);
  }
  .block__grid :global(.card__meta) {
    text-align: center;
    padding-top: 16px;
  }
  .block__grid :global(.card__title) {
    font-size: clamp(16px, 1.5vw, 20px);
  }

  .block__empty {
    text-align: center;
    margin: 0;
    padding: clamp(28px, 5vw, 52px) 0;
    color: var(--muted);
    font-size: 15px;
  }

  /* 더 보기 — 테두리 없이 텍스트 + 아래 화살표만 */
  .block__more {
    margin-top: clamp(18px, 3vh, 32px);
    text-align: center;
  }
  .more-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.18s ease;
  }
  .more-btn:hover {
    color: var(--fg);
  }
  .more-btn__arrow {
    font-size: 16px;
    line-height: 1;
    animation: moreBounce 1.8s var(--ease) infinite;
  }
  .more-btn:hover .more-btn__arrow {
    animation-play-state: paused;
    transform: translateY(3px);
  }
  @keyframes moreBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .more-btn__arrow { animation: none; }
  }
</style>

<style is:global>
  /* 스냅 컨테이너 — /web 에서만 적용된다 (이 CSS는 이 페이지에서만 로드) */
  html {
    scroll-snap-type: y mandatory;
  }
  /* 마지막 화면 다음의 푸터도 스냅 지점으로 */
  .site-footer {
    scroll-snap-align: start;
  }
</style>
