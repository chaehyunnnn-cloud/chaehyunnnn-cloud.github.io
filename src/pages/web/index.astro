---
// /web — 웹디자인 메인.
// 하위 분류(제품 상세페이지 / 프로모션 / UI / 소셜)마다 한 섹션씩 세로로 쌓는다.
// 섹션 = [분류 제목(→ 하위 페이지)] + [작업 3개] + [View more(→ 하위 페이지)]
import Base from "../../layouts/Base.astro";
import Card from "../../components/Card.astro";
import { webSubs, projectsByWebSub, categoryById } from "../../data/portfolio";

const cat = categoryById("web")!;
const base = import.meta.env.BASE_URL;
const PREVIEW = 3; // 메인에서 한 분류당 보여줄 개수 (가로 3개)

const sections = webSubs.map((s) => {
  const items = projectsByWebSub(s.id);
  return { sub: s, items, shown: items.slice(0, PREVIEW), href: `${base}web/${s.id}` };
});
---

<Base title={cat.label.ko} active="web">
  {
    sections.map(({ sub, items, shown, href }) => (
      <section class="wrap block">
        <header class="block__head">
          {/* 제목을 누르면 해당 하위 분류 페이지로 */}
          <h2 class="block__h">
            <a class="block__title" href={href}>
              <span data-ko>{sub.label.ko}</span>
              <span data-en>{sub.label.en}</span>
              <span class="block__arrow" aria-hidden="true">→</span>
            </a>
          </h2>
          {items.length > 0 && (
            <span class="block__count">{String(items.length).padStart(2, "0")}</span>
          )}
        </header>

        {shown.length > 0 ? (
          <div class="grid block__grid">
            {shown.map((p) => (
              <Card project={p} />
            ))}
          </div>
        ) : (
          <p class="block__empty">
            <span data-ko>아직 등록된 작업이 없습니다.</span>
            <span data-en>No projects yet.</span>
          </p>
        )}

        <div class="block__more">
          <a class="more-btn" href={href}>
            <span data-ko>더 보기</span>
            <span data-en>View more</span>
            <span class="more-btn__arrow" aria-hidden="true">↓</span>
          </a>
        </div>
      </section>
    ))
  }
</Base>

<style>
  /* ── 한 분류 = 한 화면 (스크롤 스냅) ─────────────────────────────────
     .site-header가 position:sticky(높이 --header-h)라 화면 위를 덮는다.
     그래서 (1) 스냅 위치를 헤더 높이만큼 내리고(scroll-padding-top)
            (2) 섹션 높이도 그만큼 빼서 딱 한 화면에 들어맞게 한다. */
  .block {
    min-height: calc(100svh - var(--header-h) - 1px); /* -1px = 헤더 하단 보더 */
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: clamp(16px, 3vh, 40px);
    scroll-snap-align: start;
    scroll-snap-stop: always; /* 한 번에 여러 화면 건너뛰지 않게 */
  }

  /* 분류 제목 줄 — 제목 + 개수, 중앙 정렬 */
  .block__head {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 12px;
    padding-bottom: clamp(12px, 1.8vh, 22px);
    border-bottom: 1px solid var(--line);
    margin-bottom: clamp(16px, 2.6vh, 30px);
  }
  .block__h {
    margin: 0;
    font-weight: 600;
  }
  .block__title {
    font-size: clamp(24px, 3.6vw, 44px);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    color: var(--fg);
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  .block__arrow {
    font-size: 0.62em;
    color: var(--muted);
    transform: translateX(-4px);
    opacity: 0;
    transition: transform 0.28s var(--ease), opacity 0.28s var(--ease);
  }
  .block__title:hover .block__arrow {
    transform: none;
    opacity: 1;
  }
  .block__count {
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 13px;
    color: var(--muted);
  }

  /* 컨텐츠 크게 — 카드 이미지 높이를 화면 높이에 맞춰 */
  .block__grid {
    padding-bottom: 0;
  }
  .block__grid :global(.card__media) {
    aspect-ratio: auto;
    height: clamp(200px, 44vh, 540px);
  }
  .block__grid :global(.card__meta) {
    text-align: center;
    padding-top: 14px;
  }
  .block__grid :global(.card__title) {
    font-size: clamp(16px, 1.5vw, 20px);
  }

  .block__empty {
    text-align: center;
    margin: 0;
    padding: clamp(28px, 6vh, 60px) 0;
    color: var(--muted);
    font-size: 15px;
  }

  /* 더 보기 — 테두리 없이 텍스트 + 아래 화살표만 */
  .block__more {
    margin-top: clamp(16px, 2.6vh, 30px);
    text-align: center;
  }
  .more-btn {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    font-family: "Space Mono", ui-monospace, monospace;
    font-size: 13px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.18s ease;
  }
  .more-btn:hover {
    color: var(--fg);
  }
  .more-btn__arrow {
    font-size: 16px;
    line-height: 1;
    animation: moreBounce 1.8s var(--ease) infinite;
  }
  .more-btn:hover .more-btn__arrow {
    animation-play-state: paused;
    transform: translateY(3px);
  }
  @keyframes moreBounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .more-btn__arrow { animation: none; }
  }
</style>

<style is:global>
  /* 스냅 컨테이너 — 이 CSS는 /web 에서만 로드된다 */
  html {
    scroll-snap-type: y mandatory;
    /* 스티키 헤더(72px + 보더 1px)에 가려지지 않도록 스냅 기준선을 그 아래로 */
    scroll-padding-top: calc(var(--header-h) + 1px);
  }
  /* 푸터도 스냅 지점으로 두어 마지막 화면 뒤가 어정쩡하게 걸리지 않게 */
  .site-footer {
    scroll-snap-align: start;
  }
</style>
