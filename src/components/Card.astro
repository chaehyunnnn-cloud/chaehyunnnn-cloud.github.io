---
import type { Project } from "../data/portfolio";
import { cardSrc } from "../lib/img";

interface Props {
  project: Project;
}
const { project } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a class="card" href={`${base}work/${project.slug}`}>
  <div class="card__media">
    <img src={cardSrc(project)} alt="" loading="lazy" transition:name={`photo-${project.slug}`} />
  </div>
  <div class="card__meta">
    <div class="card__title">
      <span data-ko>{project.title.ko}</span>
      <span data-en>{project.title.en}</span>
    </div>
    {
      (project.year || project.summary) && (
        <div class="card__sub">
          {project.summary ? (
            <>
              <span data-ko>{project.summary.ko}</span>
              <span data-en>{project.summary.en}</span>
            </>
          ) : (
            project.year
          )}
        </div>
      )
    }
  </div>
</a>
